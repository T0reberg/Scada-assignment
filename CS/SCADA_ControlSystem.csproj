<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCADA_ControlSystem</RootNamespace>
    <AssemblyName>SCADA_ControlSystem</AssemblyName>
    <LangVersion>10</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Opc.UaFx.Advanced includes both server and client -->
    <PackageReference Include="Opc.UaFx.Advanced"      Version="2.*" />
    <PackageReference Include="ScottPlot.WinForms"      Version="4.1.71" />
  </ItemGroup>
</Project>
